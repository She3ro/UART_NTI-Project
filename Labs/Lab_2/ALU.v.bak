module ALU # ( parameter width = 8) (
  input wire [width - 1: 0] a,
  input wire [width - 1: 0] b,
  input wire [2: 0] opt,
  output reg [width : 0] out,
  output reg zero
  );
  
  always @ (*)
  begin
    case (opt)
      000: out = a;
      001: out = b - a;
      010: out = a + b;
      011: out = a & b;
      100: out = a ^ b;
      101: out = b;
      110: out = a;
      111: out = a;
      default: begin
        out = 1'b0;
      end
    endcase
end

always @ (*)
begin
if (a == 0)
zero = 1'b1;
else
zero = 1'b0;
end
   
endmodule